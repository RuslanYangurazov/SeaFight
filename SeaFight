<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>Морской бой</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap');

:root{
  --navy-deep:#0b2545;
  --navy-mid:#123a68;
  --navy-panel:#0f2f57;
  --paper:#f1e9d2;
  --paper-line:#d9cca0;
  --brass:#c9a227;
  --brass-light:#e8c766;
  --danger:#c14b3a;
  --miss:#7fa4c4;
  --ink:#1b2430;
  --ink-soft:#5a6472;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:
    radial-gradient(ellipse at top, #17427a 0%, var(--navy-deep) 55%),
    var(--navy-deep);
  min-height:100vh;
  font-family:'Inter',sans-serif;
  color:var(--paper);
  display:flex;
  justify-content:center;
  padding:24px 12px 60px;
}

#app{ width:100%; max-width:960px; }

.title-row{
  display:flex; align-items:center; justify-content:center;
  gap:14px; margin-bottom:6px;
}
.compass{ width:46px; height:46px; flex-shrink:0; animation: spin 40s linear infinite; }
@keyframes spin{ from{transform:rotate(0deg);} to{transform:rotate(360deg);} }

h1.game-title{
  font-family:'Playfair Display',serif;
  font-weight:900;
  font-size:clamp(28px,6vw,44px);
  letter-spacing:2px;
  margin:0;
  text-align:center;
  color:var(--paper);
  text-shadow:0 2px 0 rgba(0,0,0,0.35);
}
.subtitle{
  text-align:center;
  color:#a9c2de;
  font-size:14px;
  margin:0 0 28px;
  letter-spacing:0.5px;
}

.card{
  background:var(--navy-panel);
  border:1px solid rgba(201,162,39,0.35);
  border-radius:14px;
  padding:24px;
  box-shadow:0 20px 40px rgba(0,0,0,0.35);
}

.field{ margin-bottom:16px; }
.field label{
  display:block; font-size:12px; text-transform:uppercase;
  letter-spacing:1.5px; color:var(--brass-light); margin-bottom:6px; font-weight:600;
}
.field input{
  width:100%; padding:12px 14px; border-radius:8px; border:1px solid rgba(255,255,255,0.15);
  background:rgba(255,255,255,0.06); color:var(--paper); font-size:16px; font-family:'JetBrains Mono',monospace;
  letter-spacing:1px;
}
.field input:focus{ outline:2px solid var(--brass); outline-offset:1px; }

.row{ display:flex; gap:10px; flex-wrap:wrap; }
.row > *{ flex:1; }

button{
  font-family:'Inter',sans-serif; font-weight:600; font-size:15px;
  padding:12px 18px; border-radius:8px; border:none; cursor:pointer;
  transition:transform .12s ease, filter .12s ease;
}
button:active{ transform:scale(0.97); }
button:focus-visible{ outline:2px solid #fff; outline-offset:2px; }
button.primary{ background:linear-gradient(180deg,var(--brass-light),var(--brass)); color:#2a220a; }
button.primary:hover{ filter:brightness(1.08); }
button.ghost{ background:transparent; color:var(--paper); border:1px solid rgba(255,255,255,0.25); }
button.ghost:hover{ background:rgba(255,255,255,0.06); }
button:disabled{ opacity:0.4; cursor:not-allowed; }

.hint{ color:#9fb6d1; font-size:13px; line-height:1.5; margin-top:10px; }

.room-badge{
  display:inline-flex; align-items:center; gap:8px;
  font-family:'JetBrains Mono',monospace; font-weight:700; letter-spacing:3px;
  background:rgba(201,162,39,0.15); border:1px dashed var(--brass);
  padding:8px 16px; border-radius:8px; color:var(--brass-light); font-size:18px;
}

.status-bar{
  display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
  margin-bottom:18px;
}
.turn-pill{
  display:inline-flex; align-items:center; gap:8px;
  padding:8px 14px; border-radius:999px; font-weight:600; font-size:14px;
  background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12);
}
.dot{ width:9px; height:9px; border-radius:50%; background:var(--brass); }
.dot.pulse{ animation:pulse 1.2s infinite; }
@keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.25;} }

.boards{
  display:grid; grid-template-columns:1fr 1fr; gap:22px;
}
@media (max-width:720px){ .boards{ grid-template-columns:1fr; } }

.board-block h3{
  font-family:'Playfair Display',serif; font-size:18px; margin:0 0 10px;
  color:var(--brass-light); letter-spacing:0.5px; text-align:center;
}

.grid-wrap{ display:flex; justify-content:center; }
.grid-inner{ display:inline-block; }
.col-labels, .grid-row{ display:flex; }
.col-labels{ margin-left:26px; }
.corner, .col-label{
  width:var(--cell,30px); height:20px; display:flex; align-items:center; justify-content:center;
  font-family:'JetBrains Mono',monospace; font-size:11px; color:#9fb6d1;
}
.row-label{
  width:26px; height:var(--cell,30px); display:flex; align-items:center; justify-content:center;
  font-family:'JetBrains Mono',monospace; font-size:11px; color:#9fb6d1;
}
.cell{
  width:var(--cell,30px); height:var(--cell,30px);
  background:var(--paper);
  border:1px solid var(--paper-line);
  position:relative;
  display:flex; align-items:center; justify-content:center;
}
.cell.clickable{ cursor:crosshair; }
.cell.clickable:hover{ background:#e6dcb8; }
.cell.ship{ background:#8a9bad; }
.cell.ship.own{ background:#5c7690; }
.cell.hit{ background:var(--danger); }
.cell.hit::after{
  content:''; width:55%; height:55%; border-radius:50%;
  background:radial-gradient(circle,#fff2c2,var(--danger) 70%);
}
.cell.miss::after{
  content:''; width:40%; height:40%; border-radius:50%;
  background:var(--miss); opacity:0.9;
}
.cell.sunk{ background:#7a2318; }

.fleet-panel{
  margin-top:16px; padding:14px; background:rgba(255,255,255,0.05);
  border-radius:10px; border:1px solid rgba(255,255,255,0.1);
}
.fleet-panel h4{ margin:0 0 10px; font-size:13px; letter-spacing:1px; text-transform:uppercase; color:var(--brass-light); }
.fleet-list{ display:flex; flex-wrap:wrap; gap:8px; }
.ship-chip{
  font-family:'JetBrains Mono',monospace; font-size:12px; padding:6px 10px;
  border-radius:6px; background:rgba(255,255,255,0.08); color:var(--paper);
  border:1px solid rgba(255,255,255,0.15);
}
.ship-chip.active{ background:var(--brass); color:#2a220a; border-color:var(--brass); font-weight:700; }
.ship-chip.done{ opacity:0.35; text-decoration:line-through; }

.controls-row{ display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; }

.center-note{ text-align:center; color:#a9c2de; font-size:14px; margin:14px 0; }

.overlay-msg{
  text-align:center; padding:40px 20px;
}
.overlay-msg h2{ font-family:'Playfair Display',serif; font-size:30px; margin:0 0 8px; color:var(--brass-light); }
.overlay-msg p{ color:#a9c2de; }

.waiting-strip{
  display:flex; align-items:center; justify-content:center; gap:10px;
  padding:12px; border-radius:10px; background:rgba(255,255,255,0.05); margin-bottom:16px;
  font-size:14px; color:#c9d8ea;
}

.error-msg{ color:#ffb3a3; font-size:13px; margin-top:8px; }
</style>
</head>
<body>
<div id="app"></div>

<script>
const CELL_SIZE = window.innerWidth < 480 ? 28 : 34;
document.documentElement.style.setProperty('--cell', CELL_SIZE + 'px');

const FLEET = [4,3,3,2,2,2,1,1,1,1]; // классический русский флот, 20 клеток
const TOTAL_CELLS = FLEET.reduce((a,b)=>a+b,0);
const COL_LABELS = ['A','B','C','D','E','F','G','H','I','J'];

let state = {
  screen: 'lobby', // lobby | waiting | placement | battle | gameover
  roomCode: '',
  myName: '',
  role: null, // 1 or 2
  room: null, // shared room object
  placement: { ships: [], occupied: new Set() },
  orientation: 'H',
  errorMsg: '',
  poller: null
};

function key(code){ return 'battleship-room-' + code.toUpperCase(); }

async function getRoom(code){
  try{
    const r = await window.storage.get(key(code), true);
    return r ? JSON.parse(r.value) : null;
  }catch(e){ return null; }
}
async function setRoom(code, obj){
  try{
    await window.storage.set(key(code), JSON.stringify(obj), true);
    return true;
  }catch(e){ console.error('storage error', e); return false; }
}

function idxToRC(idx){ return [Math.floor(idx/10), idx%10]; }
function rcToIdx(r,c){ return r*10+c; }

function tryPlace(startIdx, len, orientation, occupiedSet){
  const [r0,c0] = idxToRC(startIdx);
  const cells = [];
  for(let i=0;i<len;i++){
    const r = orientation==='V' ? r0+i : r0;
    const c = orientation==='H' ? c0+i : c0;
    if(r<0||r>9||c<0||c>9) return null;
    cells.push(rcToIdx(r,c));
  }
  for(const cell of cells){
    const [r,c] = idxToRC(cell);
    for(let dr=-1;dr<=1;dr++){
      for(let dc=-1;dc<=1;dc++){
        const nr=r+dr, nc=c+dc;
        if(nr<0||nr>9||nc<0||nc>9) continue;
        const nidx = rcToIdx(nr,nc);
        if(occupiedSet.has(nidx) && !cells.includes(nidx)) return null;
      }
    }
  }
  return cells;
}

function randomPlaceAll(){
  for(let attempt=0; attempt<300; attempt++){
    const occupied = new Set();
    const ships = [];
    let ok = true;
    for(const len of FLEET){
      let placed = false;
      for(let tries=0; tries<300; tries++){
        const orientation = Math.random()<0.5 ? 'H':'V';
        const r0 = Math.floor(Math.random()*10);
        const c0 = Math.floor(Math.random()*10);
        const cells = tryPlace(rcToIdx(r0,c0), len, orientation, occupied);
        if(cells){ cells.forEach(x=>occupied.add(x)); ships.push(cells); placed=true; break; }
      }
      if(!placed){ ok=false; break; }
    }
    if(ok) return ships;
  }
  return null;
}

function render(){
  const app = document.getElementById('app');
  app.innerHTML = '';
  app.appendChild(header());

  if(state.screen === 'lobby') app.appendChild(renderLobby());
  else if(state.screen === 'waiting') app.appendChild(renderWaiting());
  else if(state.screen === 'placement') app.appendChild(renderPlacement());
  else if(state.screen === 'battle') app.appendChild(renderBattle());
  else if(state.screen === 'gameover') app.appendChild(renderGameOver());
}

function header(){
  const wrap = document.createElement('div');
  wrap.innerHTML = `
    <div class="title-row">
      <svg class="compass" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="46" fill="none" stroke="#c9a227" stroke-width="2"/>
        <circle cx="50" cy="50" r="3" fill="#c9a227"/>
        <polygon points="50,10 56,50 50,90 44,50" fill="#e8c766"/>
        <polygon points="10,50 50,44 90,50 50,56" fill="#f1e9d2" opacity="0.5"/>
      </svg>
      <h1 class="game-title">МОРСКОЙ БОЙ</h1>
    </div>
    <p class="subtitle">Онлайн-версия для игры на разных устройствах</p>
  `;
  return wrap;
}

// ---------- LOBBY ----------
function renderLobby(){
  const card = document.createElement('div');
  card.className = 'card';
  card.innerHTML = `
    <div class="field">
      <label>Ваше имя</label>
      <input id="nameInput" type="text" maxlength="16" placeholder="Например: Папа" value="${state.myName}"/>
    </div>
    <div class="field">
      <label>Код комнаты</label>
      <input id="codeInput" type="text" maxlength="6" placeholder="Например: KRAB7" value="${state.roomCode}" style="text-transform:uppercase"/>
    </div>
    <div class="row">
      <button class="primary" id="joinBtn">Войти в комнату</button>
      <button class="ghost" id="randomBtn">Создать новый код</button>
    </div>
    <p class="hint">Один игрок создаёт код и сообщает его второму (например, в сообщении или по телефону). Затем оба открывают эту же игру и вводят один и тот же код — каждый на своём устройстве.</p>
    ${state.errorMsg ? `<p class="error-msg">${state.errorMsg}</p>` : ''}
  `;
  card.querySelector('#randomBtn').onclick = () => {
    const code = Math.random().toString(36).substring(2,7).toUpperCase();
    card.querySelector('#codeInput').value = code;
  };
  card.querySelector('#joinBtn').onclick = async () => {
    const name = card.querySelector('#nameInput').value.trim();
    const code = card.querySelector('#codeInput').value.trim().toUpperCase();
    if(!name || !code){
      state.errorMsg = 'Введите имя и код комнаты.';
      render();
      return;
    }
    state.myName = name;
    state.roomCode = code;
    state.errorMsg = '';
    await joinRoom();
  };
  return card;
}

async function joinRoom(){
  let room = await getRoom(state.roomCode);
  if(!room){
    room = {
      player1: { name: state.myName, ships: [], ready: false, shots: [] },
      player2: null,
      turn: 1,
      winner: null
    };
    await setRoom(state.roomCode, room);
    state.role = 1;
  } else if(!room.player2){
    if(room.player1.name.toLowerCase() === state.myName.toLowerCase()){
      state.role = 1;
    } else {
      room.player2 = { name: state.myName, ships: [], ready: false, shots: [] };
      const ok = await setRoom(state.roomCode, room);
      if(!ok){ state.errorMsg = 'Не удалось подключиться, попробуйте ещё раз.'; render(); return; }
      state.role = 2;
    }
  } else {
    if(room.player1.name.toLowerCase() === state.myName.toLowerCase()) state.role = 1;
    else if(room.player2.name.toLowerCase() === state.myName.toLowerCase()) state.role = 2;
    else {
      state.errorMsg = 'Комната уже занята двумя игроками. Придумайте новый код или используйте то же имя, что и раньше.';
      render();
      return;
    }
  }
  state.room = room;
  startPolling();
  updateScreenFromRoom();
}

function startPolling(){
  if(state.poller) clearInterval(state.poller);
  state.poller = setInterval(async () => {
    if(state.screen === 'lobby') return;
    const room = await getRoom(state.roomCode);
    if(!room) return;
    state.room = room;
    updateScreenFromRoom(true);
  }, 2000);
}

function updateScreenFromRoom(isPoll){
  const room = state.room;
  if(!room){ render(); return; }
  const me = room['player' + state.role];
  const opp = room['player' + (state.role===1?2:1)];

  if(room.winner){
    state.screen = 'gameover';
  } else if(!opp){
    state.screen = 'waiting';
  } else if(!me.ready || !opp.ready){
    // if we already placed locally but not yet marked ready in room, keep placement screen
    if(state.screen !== 'placement' || !isPoll) state.screen = 'placement';
    if(me.ready) state.screen = 'placement'; // waiting for opponent, still show placement view (locked)
  } else {
    state.screen = 'battle';
  }
  render();
}

// ---------- WAITING ----------
function renderWaiting(){
  const card = document.createElement('div');
  card.className = 'card';
  card.innerHTML = `
    <div class="overlay-msg">
      <div class="room-badge">${state.roomCode}</div>
      <h2 style="margin-top:20px;">Ждём второго игрока…</h2>
      <p>Сообщите этот код второму игроку. Как только он введёт его на своём устройстве, игра начнётся автоматически.</p>
    </div>
  `;
  return card;
}

// ---------- PLACEMENT ----------
function renderPlacement(){
  const room = state.room;
  const me = room['player' + state.role];
  const wrap = document.createElement('div');

  if(me.ready){
    wrap.innerHTML = `
      <div class="waiting-strip"><span class="dot pulse"></span> Корабли расставлены. Ждём соперника…</div>
    `;
    wrap.appendChild(renderOwnGrid(me.ships, [], false));
    return wrap;
  }

  const placedCount = state.placement.ships.length;
  const nextLen = FLEET[placedCount];
  const done = placedCount === FLEET.length;

  const card = document.createElement('div');
  card.className = 'card';

  const gridHolder = document.createElement('div');
  gridHolder.className = 'grid-wrap';
  gridHolder.appendChild(buildGrid({
    cellClass: (idx) => {
      let cls = 'cell';
      if(state.placement.occupied.has(idx)) cls += ' ship own';
      return cls;
    },
    onClick: done ? null : (idx) => {
      const cells = tryPlace(idx, nextLen, state.orientation, state.placement.occupied);
      if(cells){
        cells.forEach(c => state.placement.occupied.add(c));
        state.placement.ships.push(cells);
        render();
      }
    },
    clickable: !done
  }));

  card.innerHTML = `<h3 style="font-family:'Playfair Display',serif;color:var(--brass-light);text-align:center;margin-top:0;">Расставьте свой флот</h3>`;
  card.appendChild(gridHolder);

  const fleetPanel = document.createElement('div');
  fleetPanel.className = 'fleet-panel';
  fleetPanel.innerHTML = `<h4>Флот (клик по клетке — поставить нос корабля вправо/вниз)</h4>`;
  const list = document.createElement('div');
  list.className = 'fleet-list';
  FLEET.forEach((len, i) => {
    const chip = document.createElement('span');
    chip.className = 'ship-chip' + (i < placedCount ? ' done' : (i===placedCount ? ' active':''));
    chip.textContent = '⚓ ' + len + '-палубный';
    list.appendChild(chip);
  });
  fleetPanel.appendChild(list);
  card.appendChild(fleetPanel);

  const controls = document.createElement('div');
  controls.className = 'controls-row';
  controls.innerHTML = `
    <button class="ghost" id="orientBtn">Ориентация: ${state.orientation==='H' ? 'по горизонтали →' : 'по вертикали ↓'}</button>
    <button class="ghost" id="randBtn">Случайная расстановка</button>
    <button class="ghost" id="resetBtn">Сбросить</button>
    <button class="primary" id="readyBtn" ${done ? '' : 'disabled'}>Готов к бою!</button>
  `;
  card.appendChild(controls);

  controls.querySelector('#orientBtn').onclick = () => { state.orientation = state.orientation==='H'?'V':'H'; render(); };
  controls.querySelector('#randBtn').onclick = () => {
    const ships = randomPlaceAll();
    if(ships){
      state.placement.ships = ships;
      state.placement.occupied = new Set(ships.flat());
    }
    render();
  };
  controls.querySelector('#resetBtn').onclick = () => {
    state.placement = { ships: [], occupied: new Set() };
    render();
  };
  controls.querySelector('#readyBtn').onclick = async () => {
    const flat = state.placement.ships.flat();
    const room2 = await getRoom(state.roomCode) || state.room;
    room2['player'+state.role].ships = flat;
    room2['player'+state.role].ready = true;
    await setRoom(state.roomCode, room2);
    state.room = room2;
    render();
  };

  wrap.appendChild(card);
  return wrap;
}

function buildGrid({cellClass, onClick, clickable}){
  const inner = document.createElement('div');
  inner.className = 'grid-inner';

  const colLabels = document.createElement('div');
  colLabels.className = 'col-labels';
  colLabels.innerHTML = '<div class="corner"></div>' + COL_LABELS.map(l=>`<div class="col-label">${l}</div>`).join('');
  inner.appendChild(colLabels);

  for(let r=0;r<10;r++){
    const rowDiv = document.createElement('div');
    rowDiv.className = 'grid-row';
    const rl = document.createElement('div');
    rl.className = 'row-label';
    rl.textContent = (r+1);
    rowDiv.appendChild(rl);
    for(let c=0;c<10;c++){
      const idx = rcToIdx(r,c);
      const cell = document.createElement('div');
      cell.className = cellClass(idx) + (clickable ? ' clickable' : '');
      if(onClick) cell.onclick = () => onClick(idx);
      rowDiv.appendChild(cell);
    }
    inner.appendChild(rowDiv);
  }
  const wrap = document.createElement('div');
  wrap.appendChild(inner);
  return wrap;
}

function renderOwnGrid(myShipsFlat, incomingShots, clickable){
  const shipSet = new Set(myShipsFlat);
  return buildGrid({
    cellClass: (idx) => {
      let cls = 'cell';
      const shot = incomingShots.find(s => s.idx === idx);
      if(shot){
        cls += shot.hit ? ' hit' : ' miss';
      } else if(shipSet.has(idx)){
        cls += ' ship own';
      }
      return cls;
    },
    onClick: null,
    clickable: false
  });
}

// ---------- BATTLE ----------
function renderBattle(){
  const room = state.room;
  const me = room['player'+state.role];
  const opp = room['player'+(state.role===1?2:1)];
  const myTurn = room.turn === state.role;

  const wrap = document.createElement('div');

  const statusBar = document.createElement('div');
  statusBar.className = 'status-bar';
  statusBar.innerHTML = `
    <div class="room-badge" style="font-size:14px;padding:6px 12px;">${state.roomCode}</div>
    <div class="turn-pill">
      <span class="dot ${myTurn ? 'pulse':''}"></span>
      ${myTurn ? 'Ваш ход — стреляйте!' : 'Ход соперника (' + opp.name + ')'}
    </div>
  `;
  wrap.appendChild(statusBar);

  const boards = document.createElement('div');
  boards.className = 'boards';

  const myBlock = document.createElement('div');
  myBlock.className = 'board-block';
  myBlock.innerHTML = `<h3>Ваш флот</h3>`;
  myBlock.appendChild(renderOwnGrid(me.ships, opp.shots, false));
  boards.appendChild(myBlock);

  const enemyBlock = document.createElement('div');
  enemyBlock.className = 'board-block';
  enemyBlock.innerHTML = `<h3>Акватория соперника</h3>`;
  const alreadyShot = new Set(me.shots.map(s=>s.idx));
  enemyBlock.appendChild(buildGrid({
    cellClass: (idx) => {
      let cls = 'cell';
      const shot = me.shots.find(s=>s.idx===idx);
      if(shot) cls += shot.hit ? ' hit' : ' miss';
      return cls;
    },
    onClick: (myTurn) ? (idx) => fireShot(idx) : null,
    clickable: myTurn
  }));
  boards.appendChild(enemyBlock);

  wrap.appendChild(boards);
  return wrap;
}

async function fireShot(idx){
  const fresh = await getRoom(state.roomCode) || state.room;
  const me = fresh['player'+state.role];
  const opp = fresh['player'+(state.role===1?2:1)];
  if(fresh.turn !== state.role) { state.room = fresh; render(); return; }
  if(me.shots.find(s=>s.idx===idx)) return;

  const hit = opp.ships.includes(idx);
  me.shots.push({ idx, hit });

  const totalHits = me.shots.filter(s=>s.hit).length;
  if(totalHits >= TOTAL_CELLS){
    fresh.winner = state.role;
  } else {
    fresh.turn = state.role===1 ? 2 : 1;
  }
  await setRoom(state.roomCode, fresh);
  state.room = fresh;
  render();
}

// ---------- GAME OVER ----------
function renderGameOver(){
  const room = state.room;
  const won = room.winner === state.role;
  const card = document.createElement('div');
  card.className = 'card';
  card.innerHTML = `
    <div class="overlay-msg">
      <h2>${won ? '🏆 Вы победили!' : '💥 Соперник победил'}</h2>
      <p>${won ? 'Весь флот противника потоплен.' : 'Ваш флот потоплен полностью.'}</p>
    </div>
  `;
  const btn = document.createElement('div');
  btn.style.textAlign = 'center';
  btn.innerHTML = `<button class="primary" id="againBtn">Играть снова</button>`;
  btn.querySelector('#againBtn').onclick = async () => {
    const fresh = await getRoom(state.roomCode) || state.room;
    fresh.player1.ships = []; fresh.player1.ready = false; fresh.player1.shots = [];
    if(fresh.player2){ fresh.player2.ships = []; fresh.player2.ready = false; fresh.player2.shots = []; }
    fresh.turn = 1;
    fresh.winner = null;
    await setRoom(state.roomCode, fresh);
    state.room = fresh;
    state.placement = { ships: [], occupied: new Set() };
    state.screen = 'placement';
    render();
  };
  card.appendChild(btn);
  return card;
}

render();
</script>
